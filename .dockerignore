# Source-only build context; new files are excluded unless explicitly allowed.
**
!Dockerfile
!requirements.txt
!README.md
!src/
!src/**/
!src/**/*.py
!scripts/
!scripts/**/
!scripts/**/*.py
!scripts/**/*.sh
!configs/
!configs/**/
!configs/**/*.yaml
!configs/**/*.yml
!configs/**/*.json
!docs/
!docs/experiment_protocol.md
!docs/sidd_evaluation.md

# Keep local tests out of source builds.
**/tests/
**/test_*.py
**/*_test.py
**/smoke_*.py

